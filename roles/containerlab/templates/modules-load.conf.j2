{{ ansible_managed | comment }}
# Rendered by roles/containerlab. Edits here are overwritten on the next run.
#
# Read at boot by systemd-modules-load.service. Without it the modules are
# loaded only until the next power cycle, and what follows is silent: tc accepts
# a netem qdisc against a kernel with no sch_netem by impairing nothing, so a
# fault scenario runs to completion, the agent correctly diagnoses a healthy
# network, and the miss is scored against the agent rather than against the host.
{% for module in containerlab_kernel_modules %}
{{ module }}
{% endfor %}
